[core]
    pager = delta
[delta]
    navigate = true
    line-numbers = true
    hunk-header-style = "omit"
    file-added-label = "+"
    file-removed-label = "-"
[delta "light"]
    plus-style = "syntax greenyellow"
    plus-emph-style = "syntax limegreen"
    file-style = "blue bold"
    minus-style = "syntax lightsalmon"
    minus-emph-style = "syntax darksalmon"
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = false
